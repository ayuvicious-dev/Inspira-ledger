  </tbody></table></div>`;
  bindJurnalRowActions(wrap);
}

/* ================= TERIMA / KIRIM / TRANSFER UANG ================= */
let cashFormSearch = {};
function simpleCashForm(c, opts){
  // opts: {kasLabel, lawanLabel, lawanFilter, debitIsKas, sumber}
  const searchKey = opts.sumber;
  const term = cashFormSearch[searchKey] || '';
  let html = `<div class="card">
    <div class="formgrid">
      <div class="field"><label>Tanggal</label><input type="date" id="fTgl" value="${todayStr()}"></div>
      <div class="field" style="grid-column:span 2"><label>Keterangan</label><input id="fKet" placeholder="Deskripsi"></div>
      <div class="field"><label>Nominal</label><input type="number" id="fNom" placeholder="0"></div>
    </div>
    <div class="formgrid">
      <div class="field" style="grid-column:span 2"><label>${opts.kasLabel}</label>${akunPickerHtml('fKas', isKasBank, 'Ketik nama akun kas/bank...')}</div>
      <div class="field" style="grid-column:span 2"><label>${opts.lawanLabel}</label>${akunPickerHtml('fLawan', opts.lawanFilter, 'Ketik nama akun...')}</div>
    </div>
    <div class="formgrid">${tagInputHtml('fTagInput')}</div>
    <button class="btn primary" id="btnPostSimple">Simpan Transaksi</button>
  </div>
  <div class="card" style="margin-top:14px">
  <div class="section-title"><h3 id="cashCountTitle">Riwayat (${opts.sumber})</h3>${searchBoxHtml('cashSearchInput','Cari keterangan/akun')}</div>
  <div id="cashTableWrap"></div></div>`;
  c.innerHTML = html;
  bindAllAkunPickers(c);
  renderCashTable(opts);
  document.getElementById('cashSearchInput').addEventListener('input', e=>{ cashFormSearch[searchKey]=e.target.value; renderCashTable(opts); });
  document.getElementById('btnPostSimple').addEventListener('click', ()=>{
    const kasId=fKas.value, lawanId=fLawan.value, nominal=Number(fNom.value);
    if(!kasId||!lawanId) return toast('Lengkapi akun');
    if(!nominal||nominal<=0) return toast('Isi nominal');
    const debitId = opts.debitIsKas?kasId:lawanId;
    const kreditId = opts.debitIsKas?lawanId:kasId;
    const tags = parseTagInput(fTagInput.value); tags.forEach(ensureTag);
    postJurnal({tanggal:fTgl.value, keterangan:fKet.value, debitId, kreditId, nominal, sumber:opts.sumber, tags});
    save();
    fKet.value=''; fNom.value=''; fTagInput.value='';
    setAkunPickerValue('fKas', null); setAkunPickerValue('fLawan', null);
    renderCashTable(opts); toast('Tersimpan');
  });
}

function renderCashTable(opts){
  const wrap = document.getElementById('cashTableWrap'); if(!wrap) return;
  const searchKey = opts.sumber;
  const term = cashFormSearch[searchKey] || '';
  const titleEl = document.getElementById('cashCountTitle');
  const rows = [...DB.jurnal].filter(j=>j.sumber===opts.sumber).filter(j=>{
    const kasAkun = opts.debitIsKas?akunById(j.debitId):akunById(j.kreditId);
    const lawanAkun = opts.debitIsKas?akunById(j.kreditId):akunById(j.debitId);
    return matchSearch(j.keterangan+' '+(kasAkun?.nama||'')+' '+(lawanAkun?.nama||''), term);
  });
  if(titleEl) titleEl.textContent = 'Riwayat ('+opts.sumber+')';
  wrap.innerHTML = `<div class="tablewrap"><table class="sheet"><thead><tr><th>Tanggal</th><th>Keterangan</th><th>Akun Kas/Bank</th><th>Akun Lawan</th><th>Nominal</th><th>Tag</th><th></th></tr></thead><tbody>
  ${rows.reverse().map(j=>{
    const kasAkun = opts.debitIsKas?akunById(j.debitId):akunById(j.kreditId);
    const lawanAkun = opts.debitIsKas?akunById(j.kreditId):akunById(j.debitId);
    return `<tr><td>${j.tanggal}</td><td>${j.keterangan||'-'}</td><td>${kasAkun?.nama||'?'}</td><td>${lawanAkun?.nama||'?'}</td><td class="num">${fmtRp(j.nominal)}</td><td>${tagChipsHtml(j.tags)}</td><td><button class="btn small dupJ" data-jid="${j.id}">Duplikat</button> <button class="btn small editJ" data-jid="${j.id}">Edit</button> <button class="btn small danger delJ" data-jid="${j.id}">Hapus</button></td></tr>`;
  }).join('') || `<tr><td colspan="7" class="empty">Belum ada transaksi</td></tr>`}
  </tbody></table></div>`;
  bindJurnalRowActions(wrap);
}

