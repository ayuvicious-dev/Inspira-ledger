  }));
  container.querySelectorAll('.editJ').forEach(btn=> btn.addEventListener('click', ()=>{
    const j = DB.jurnal.find(x=>x.id===btn.dataset.jid); if(!j) return;
    const tgl = prompt('Tanggal (YYYY-MM-DD):', j.tanggal); if(tgl===null) return;
    const ket = prompt('Keterangan:', j.keterangan||''); if(ket===null) return;
