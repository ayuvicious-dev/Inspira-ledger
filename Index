      }
      const sisaNilaiBuku = nilaiBuku - (hargaLepas>0?0:0);
      if(nilaiBuku-hargaLepas !== 0){
        const kep = akunById(a.akunAsetId).kepemilikan;
        const blAkun = DB.coa.find(x=>x.kategori==='BL' && x.kepemilikan===kep) || DB.coa.find(x=>x.kategori==='BL');
        const pdAkun = DB.coa.find(x=>x.kategori==='PD' && x.kepemilikan===kep) || DB.coa.find(x=>x.kategori==='PD');
        const diff = nilaiBuku - hargaLepas; // positive = loss, negative = gain
        if(diff>0){
          postJurnal({ tanggal:todayStr(), keterangan:'Rugi pelepasan aset: '+a.nama, debitId:blAkun.id, kreditId:a.akunAsetId, nominal:diff, sumber:'Aset', ref:'aset-lepas-rugi-'+a.id });
