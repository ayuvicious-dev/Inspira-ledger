/* ================= HELPERS: account pickers ================= */
function akunOptions(filterFn){
  return DB.coa.filter(filterFn||(()=>true))
    .map(a=>`<option value="${a.id}">${a.nama} — ${a.kepemilikan} (${KAT[a.kategori]})</option>`).join('');
}
function isKasBank(a){ return a.kategori==='AL'; }

/* Searchable account "combo box": type to filter, click a result to select — replaces long <select>
   dropdowns so the user never has to scroll through hundreds of accounts.
   The hidden <input id="${id}"> keeps holding the selected account id, so all existing code that
   reads e.g. jDebit.value / document.getElementById('jDebit').value keeps working unchanged. */
const AKUN_PICKER_FILTERS = {};
const AKUN_PICKER_ONSELECT = {};
function akunPickerHtml(id, filterFn, placeholder, initialValue){
  AKUN_PICKER_FILTERS[id] = filterFn || null;
  const initialAkun = initialValue ? akunById(initialValue) : null;
  return `<div class="akunPicker" style="position:relative">
    <input type="text" id="${id}_q" class="akunPickerInput" placeholder="${placeholder||'Ketik nama akun...'}" autocomplete="off" value="${initialAkun?initialAkun.nama.replace(/"/g,'&quot;'):''}">
    <input type="hidden" id="${id}" value="${initialValue||''}">
    <div class="akunPickerList" id="${id}_list"></div>
  </div>`;
}
function bindAkunPicker(id, onSelect){
  if(onSelect) AKUN_PICKER_ONSELECT[id] = onSelect;
  const q = document.getElementById(id+'_q');
  const hidden = document.getElementById(id);
  const list = document.getElementById(id+'_list');
  if(!q || !hidden || !list) return;
  const filterFn = AKUN_PICKER_FILTERS[id];
  function renderList(term){
    const opts = sortAkunList(DB.coa.filter(a=> !filterFn || filterFn(a)).filter(a=> matchSearch(a.nama+' '+a.kode+' '+a.kepemilikan+' '+(a.keterangan||''), term)));
    let itemsHtml = opts.slice(0,50).map(a=>`<div class="akunPickerItem" data-id="${a.id}"><b>${a.nama}</b><span class="mini"> — ${a.kepemilikan} · ${KAT[a.kategori]}${a.keterangan?' · '+a.keterangan:''}</span></div>`).join('');
    if(!itemsHtml) itemsHtml = '<div class="akunPickerItem mini">Tidak ditemukan, coba kata kunci lain</div>';
    const exactMatch = term && DB.coa.some(a=> a.nama.toLowerCase()===term.trim().toLowerCase());
    if(term && term.trim() && !exactMatch){
      itemsHtml += `<div class="akunPickerItem akunPickerAddNew" data-newname="${term.trim().replace(/"/g,'&quot;')}" style="color:var(--terracotta-dark);font-weight:700">+ Tambah akun baru: "${term.trim()}"</div>`;
    }
    list.innerHTML = itemsHtml;
    list.style.display = 'block';
  }
  q.addEventListener('focus', ()=> renderList(q.value));
  q.addEventListener('input', ()=>{ hidden.value=''; renderList(q.value); });
  q.addEventListener('blur', ()=> setTimeout(()=>{ list.style.display='none'; }, 180));
  list.addEventListener('mousedown', e=>{
    const addItem = e.target.closest('.akunPickerAddNew');
    if(addItem){
      const namaBaru = addItem.dataset.newname;
      const katList = KATEGORI_ORDER.map((k,i)=>`${i+1}. ${KAT[k]}`).join('\n');
      const katIdx = prompt('Kategori neraca untuk akun "'+namaBaru+'":\n'+katList); if(!katIdx) return;
      const kategori = KATEGORI_ORDER[Number(katIdx)-1]; if(!kategori) return toast('Nomor tidak valid');
      const kepList = getAllKepemilikan().map((k,i)=>`${i+1}. ${k}`).join('\n');
      const kepIdx = prompt('Kepemilikan:\n'+kepList, '1'); if(!kepIdx) return;
      const kepemilikan = getAllKepemilikan()[Number(kepIdx)-1]; if(!kepemilikan) return toast('Nomor tidak valid');
      if(DB.coa.some(a=> a.nama.toLowerCase()===namaBaru.toLowerCase())) return toast('Nama akun ini sudah ada, pilih dari daftar');
      const akun = addAkun(kategori, namaBaru, kepemilikan, '');
      save();
      hidden.value = akun.id; q.value = akun.nama; list.style.display='none';
      if(AKUN_PICKER_ONSELECT[id]) AKUN_PICKER_ONSELECT[id](akun.id);
      toast('Akun baru dibuat: '+akun.nama);
      return;
    }
    const item = e.target.closest('.akunPickerItem'); if(!item || !item.dataset.id) return;
    const akun = akunById(item.dataset.id);
    hidden.value = akun.id;
    q.value = akun.nama;
    list.style.display = 'none';
    if(AKUN_PICKER_ONSELECT[id]) AKUN_PICKER_ONSELECT[id](akun.id);
  });
}
/* Call once after rendering a form containing one or more akunPickerHtml() fields. */
function bindAllAkunPickers(container){
  container.querySelectorAll('.akunPicker').forEach(wrap=>{
    const hidden = wrap.querySelector('input[type=hidden]');
    if(hidden) bindAkunPicker(hidden.id);
  });
}
/* Programmatically set an akunPickerHtml() field's value (used by the "Duplikat" transaction feature). */
function setAkunPickerValue(id, akunId){
  const hidden = document.getElementById(id);
  const q = document.getElementById(id+'_q');
  if(!hidden) return;
  hidden.value = akunId || '';
  if(q) q.value = akunId ? (akunById(akunId)?.nama || '') : '';
}

/* ================= JURNAL UMUM ================= */
let jurnalSearch = '';
/* Jurnal Umum now supports unlimited debit/kredit rows (compound entries), not just one pair.
   jurnalRows holds the working set of rows for the "Tambah Jurnal" form; state lives outside the
   renderer so it survives adding/removing rows (which only re-render the rows block, not the whole tab). */
let jurnalRows = [
  {rid:uid(), tipe:'debit', akunId:'', nominal:''},
  {rid:uid(), tipe:'kredit', akunId:'', nominal:''}
];
function jurnalRowsTotals(){
  let totalDebit=0, totalKredit=0;
  jurnalRows.forEach(r=>{ const n=Number(r.nominal)||0; if(r.tipe==='debit') totalDebit+=n; else totalKredit+=n; });
  return {totalDebit, totalKredit};
}
function syncJurnalRowsFromDom(){
  jurnalRows.forEach(r=>{
    const tipeSel = document.getElementById('jRowTipe_'+r.rid);
    const akunHidden = document.getElementById('jRowAkun_'+r.rid);
    const nomInput = document.getElementById('jRowNom_'+r.rid);
    if(tipeSel) r.tipe = tipeSel.value;
    if(akunHidden) r.akunId = akunHidden.value;
    if(nomInput) r.nominal = nomInput.value;
  });
}
function renderJurnalRowsHtml(){
  const {totalDebit, totalKredit} = jurnalRowsTotals();
  const selisih = totalDebit - totalKredit;
  const rowsHtml = jurnalRows.map(r=>`
    <div class="jrow" data-rid="${r.rid}" style="display:flex;gap:6px;align-items:center;margin-bottom:6px">
      <select id="jRowTipe_${r.rid}" class="jRowTipe" style="width:88px;flex:none">
        <option value="debit" ${r.tipe==='debit'?'selected':''}>Debit</option>
        <option value="kredit" ${r.tipe==='kredit'?'selected':''}>Kredit</option>
      </select>
      <div style="flex:1">${akunPickerHtml('jRowAkun_'+r.rid, null, 'Ketik nama akun...', r.akunId)}</div>
      <input type="number" id="jRowNom_${r.rid}" class="jRowNom" placeholder="Nominal" value="${r.nominal||''}" style="width:150px;text-align:right;flex:none">
      <button type="button" class="btn small danger btnDelJRow" data-rid="${r.rid}" style="flex:none">−</button>
    </div>`).join('');
  return `<div id="jurnalRowsWrap">
    ${rowsHtml}
    <button type="button" class="btn small" id="btnAddJRow">+ Tambah Baris</button>
    <div class="mini" id="jurnalTotalsMini" style="margin-top:8px">Total Debit: <b>${fmtRp(totalDebit)}</b> · Total Kredit: <b>${fmtRp(totalKredit)}</b> · Selisih: <b style="color:${selisih===0?'var(--debit)':'var(--kredit)'}">${fmtRp(selisih)}</b></div>
  </div>`;
}
function bindJurnalRows(){
  const wrap = document.getElementById('jurnalRowsWrap'); if(!wrap) return;
  bindAllAkunPickers(wrap);
  wrap.querySelectorAll('.jRowTipe, .jRowNom').forEach(el=> el.addEventListener('input', ()=>{
    syncJurnalRowsFromDom();
    const {totalDebit, totalKredit} = jurnalRowsTotals();
    const selisih = totalDebit-totalKredit;
    const mini = document.getElementById('jurnalTotalsMini');
    if(mini) mini.innerHTML = `Total Debit: <b>${fmtRp(totalDebit)}</b> · Total Kredit: <b>${fmtRp(totalKredit)}</b> · Selisih: <b style="color:${selisih===0?'var(--debit)':'var(--kredit)'}">${fmtRp(selisih)}</b>`;
  }));
  wrap.querySelectorAll('.btnDelJRow').forEach(btn=> btn.addEventListener('click', ()=>{
    syncJurnalRowsFromDom();
    if(jurnalRows.length<=2) return toast('Minimal 2 baris (1 debit, 1 kredit)');
    jurnalRows = jurnalRows.filter(r=>r.rid!==btn.dataset.rid);
    rerenderJurnalRows();
  }));
  const addBtn = document.getElementById('btnAddJRow');
  if(addBtn) addBtn.addEventListener('click', ()=>{
    syncJurnalRowsFromDom();
    jurnalRows.push({rid:uid(), tipe:'debit', akunId:'', nominal:''});
    rerenderJurnalRows();
  });
}
function rerenderJurnalRows(){
  const wrap = document.getElementById('jurnalRowsWrap'); if(!wrap) return;
  wrap.outerHTML = renderJurnalRowsHtml();
  bindJurnalRows();
}
RENDERERS.jurnal = function(c){
  let html = `<div class="card">
    <div class="section-title"><h3>Tambah Jurnal</h3></div>
    <div class="formgrid">
      <div class="field"><label>Tanggal</label><input type="date" id="jTgl" value="${todayStr()}"></div>
      <div class="field" style="grid-column:span 3"><label>Keterangan</label><input id="jKet" placeholder="Deskripsi transaksi"></div>
    </div>
    <div class="mini" style="margin:6px 0">Tambahkan baris sebanyak yang dibutuhkan — total Debit dan total Kredit harus sama sebelum bisa diposting.</div>
    ${renderJurnalRowsHtml()}
    <div class="formgrid" style="margin-top:8px">${tagInputHtml('jTagInput')}</div>
    <button class="btn primary" id="btnPostJurnal" style="margin-top:8px">Posting Jurnal</button>
  </div>
  <div class="card" style="margin-top:14px">
  <div class="section-title"><h3 id="jurnalCountTitle">Riwayat Jurnal (${DB.jurnal.length})</h3>${searchBoxHtml('jurnalSearchInput','Cari keterangan/akun')}</div>
  <div id="jurnalTableWrap"></div></div>`;
