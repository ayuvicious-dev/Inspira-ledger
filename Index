/* Manual stock adjustment for a bahan (DB.produk item). delta can be positive (stock in) or negative (stock out).
   Values the adjustment at the item's current weighted-average cost and posts a balancing journal entry so
   the change shows up correctly in Neraca (persediaan) and Laba Rugi (pendapatan/beban penyesuaian). */
function adjustStokBahan(p, delta){
  if(!delta) return;
  const hargaSatuan = p.hargaBeliPerSatuan||0;
  const nilai = Math.round(Math.abs(delta)*hargaSatuan);
  p.stok = (p.stok||0) + delta;
  if(nilai<=0){ save(); return; } // no recorded cost yet — just adjust stock, no journal possible
  const psAkun = DB.coa.find(a=>a.kategori==='PS' && a.kepemilikan===p.kepemilikan) || DB.coa.find(a=>a.kategori==='PS');
  if(delta>0){
    const pdAkun = DB.coa.find(a=>a.kategori==='PD' && a.kepemilikan===p.kepemilikan && a.nama==='Pendapatan Penyesuaian Persediaan') || DB.coa.find(a=>a.kategori==='PD');
    postJurnal({ tanggal:todayStr(), keterangan:'Penyesuaian tambah stok: '+p.nama+' +'+fmtNum(delta)+' '+p.satuan, debitId:psAkun.id, kreditId:pdAkun.id, nominal:nilai, sumber:'Penyesuaian Stok', ref:'adj-bahan-'+uid() });
  } else {
    const boAkun = DB.coa.find(a=>a.kategori==='BO' && a.kepemilikan===p.kepemilikan && a.nama==='Beban Penyesuaian Persediaan') || DB.coa.find(a=>a.kategori==='BO');
