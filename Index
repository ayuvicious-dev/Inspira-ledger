/* Manual stock adjustment for a barang (DB.barang item). Same accounting logic as adjustStokBahan,
   but posts against the PSB (persediaan barang) account instead of PS. */
function adjustStokBarang(b, delta){
  if(!delta) return;
  const hargaSatuan = b.hargaBeliPerSatuan||0;
  const nilai = Math.round(Math.abs(delta)*hargaSatuan);
  b.stok = (b.stok||0) + delta;
  if(nilai<=0){ save(); return; } // no recorded cost yet — just adjust stock, no journal possible
  const kep = b.kepemilikan||'Pribadi';
  const psbAkun = DB.coa.find(a=>a.kategori==='PSB' && a.kepemilikan===kep) || DB.coa.find(a=>a.kategori==='PSB');
  if(delta>0){
    const pdAkun = DB.coa.find(a=>a.kategori==='PD' && a.kepemilikan===kep && a.nama==='Pendapatan Penyesuaian Persediaan') || DB.coa.find(a=>a.kategori==='PD');
    postJurnal({ tanggal:todayStr(), keterangan:'Penyesuaian tambah stok: '+b.nama+' +'+fmtNum(delta)+' '+b.satuan, debitId:psbAkun.id, kreditId:pdAkun.id, nominal:nilai, sumber:'Penyesuaian Stok', ref:'adj-barang-'+uid() });
  } else {
    const boAkun = DB.coa.find(a=>a.kategori==='BO' && a.kepemilikan===kep && a.nama==='Beban Penyesuaian Persediaan') || DB.coa.find(a=>a.kategori==='BO');
    postJurnal({ tanggal:todayStr(), keterangan:'Penyesuaian kurang stok: '+b.nama+' -'+fmtNum(Math.abs(delta))+' '+b.satuan, debitId:boAkun.id, kreditId:psbAkun.id, nominal:nilai, sumber:'Penyesuaian Stok', ref:'adj-barang-'+uid() });
  }
  save();
}
