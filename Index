/* ---------------- JOURNAL ENGINE ---------------- */
// posts a balanced pair (debit account, credit account) for a given nominal
function postJurnal({tanggal, keterangan, debitId, kreditId, nominal, sumber, ref, tags}){
  if(!debitId || !kreditId || !nominal || Number(nominal)<=0) return null;
  const entry = { id:uid(), no: (DB.jurnal.length+1), tanggal: tanggal||todayStr(), keterangan: keterangan||'', debitId, kreditId, nominal:Number(nominal), sumber: sumber||'Jurnal Umum', ref: ref||'', tags: tags||[] };
  DB.jurnal.push(entry);
  return entry;
}
function deleteJurnalByRef(ref){ DB.jurnal = DB.jurnal.filter(j=>j.ref!==ref); }
function deleteJurnalEntry(id){ DB.jurnal = DB.jurnal.filter(j=>j.id!==id); }

/* Splits a compound journal entry (multiple debit lines + multiple credit lines, total debit === total kredit)
   into a series of simple balanced debit/kredit pairs, so it can still be posted through postJurnal() above
   without changing how the rest of the app (buku besar, neraca, laba rugi, dll) reads DB.jurnal.
   debitLines/kreditLines: array of {akunId, nominal}. Returns array of {debitId, kreditId, nominal}. */
function splitCompoundEntry(debitLines, kreditLines){
  const d = debitLines.map(x=>({akunId:x.akunId, nominal:Number(x.nominal)||0}));
  const k = kreditLines.map(x=>({akunId:x.akunId, nominal:Number(x.nominal)||0}));
  const pairs = [];
  let di=0, ki=0;
  while(di<d.length && ki<k.length){
    const amt = Math.min(d[di].nominal, k[ki].nominal);
    if(amt>0.0001) pairs.push({debitId:d[di].akunId, kreditId:k[ki].akunId, nominal:Math.round(amt)});
    d[di].nominal -= amt; k[ki].nominal -= amt;
    if(d[di].nominal<=0.0001) di++;
    if(k[ki].nominal<=0.0001) ki++;
  }
  return pairs;
}

