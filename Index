/* Renders a <select> plus small manage buttons (+ add / − remove) next to it.
   options: array of strings, value: currently selected value, selectId: id for the <select>,
   listName: DB key backing the list (for add/remove), extraOnChange: optional inline onchange js not used (we bind via JS). */
function manageableSelectHtml(selectId, options, value, listName){
  return `<div style="display:flex;gap:3px;align-items:center">
    <select id="${selectId}" data-list="${listName}">${options.map(o=>`<option value="${o.replace(/"/g,'&quot;')}" ${o===value?'selected':''}>${o}</option>`).join('')}</select>
    <button type="button" class="btn small ghost btnMasterAdd" data-list="${listName}" data-target="${selectId}" title="Tambah opsi baru" style="padding:5px 7px">+</button>
    <button type="button" class="btn small ghost danger btnMasterDel" data-list="${listName}" data-target="${selectId}" title="Hapus opsi terpilih" style="padding:5px 7px">−</button>
  </div>`;
}
/* Call this once per rendered container to wire up all manageableSelectHtml() add/remove buttons. */
function bindMasterListButtons(container, onChange){
  container.querySelectorAll('.btnMasterAdd').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const val = prompt('Tambah opsi baru:'); if(!val) return;
      ensureInList(btn.dataset.list, val.trim());
      if(btn.dataset.list==='kepemilikanCustom') ensureDepresiasiAccounts();
      save();
      const sel = document.getElementById(btn.dataset.target);
      if(sel) sel.value = val.trim();
      if(onChange) onChange(btn.dataset.list, val.trim());
      renderContent();
    });
  });
  container.querySelectorAll('.btnMasterDel').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const sel = document.getElementById(btn.dataset.target);
      const val = sel ? sel.value : '';
      if(!val) return toast('Pilih opsi yang mau dihapus dulu');
      if(!confirm('Hapus opsi "'+val+'" dari daftar master? (data yang sudah memakai nilai ini tidak ikut berubah)')) return;
      removeFromList(btn.dataset.list, val);
      save(); renderContent();
    });
  });
}

/* Ensures a persediaan (PS) / BPP account exists for a given kepemilikan, auto-creating it
   (for custom kepemilikan values added by the user beyond the default 4). */
function getOrCreateAkunForKepemilikan(kategori, kepemilikan, namaFallback){
  let akun = DB.coa.find(a=>a.kategori===kategori && a.kepemilikan===kepemilikan);
  if(!akun){
    const nama = kategori==='PS' ? 'Persediaan '+kepemilikan : kategori==='BPP' ? 'Beban Pokok '+kepemilikan : (namaFallback||kategori+' '+kepemilikan);
    akun = addAkun(kategori, nama, kepemilikan, 'Dibuat otomatis untuk kepemilikan kustom');
  }
  return akun;
}

function akunById(id){ return DB.coa.find(a=>a.id===id); }
function normalIsDebit(kategori){ return DEBIT_NORMAL.has(kategori); }

// running balance for one account, purely from jurnal
function saldoAkun(akunId){
  const akun = akunById(akunId);
  if(!akun) return 0;
  let debit=0, kredit=0;
  DB.jurnal.forEach(j=>{
    if(j.debitId===akunId) debit+=j.nominal;
    if(j.kreditId===akunId) kredit+=j.nominal;
  });
  return normalIsDebit(akun.kategori) ? (debit-kredit) : (kredit-debit);
}

function sumByKategoriKepemilikan(kategori, kepemilikan){
  return DB.coa.filter(a=>a.kategori===kategori && (!kepemilikan||a.kepemilikan===kepemilikan))
    .reduce((s,a)=> s+saldoAkun(a.id), 0);
}

/* Laba/rugi bersih per kepemilikan (Pendapatan - BPP - BO - BL) */
function labaRugiPerKepemilikan(kep){
  const pd = sumByKategoriKepemilikan('PD', kep);
  const bpp = sumByKategoriKepemilikan('BPP', kep);
  const bo = sumByKategoriKepemilikan('BO', kep);
  const bl = sumByKategoriKepemilikan('BL', kep);
  return pd - bpp - bo - bl;
}

