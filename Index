}
/* Generic search input binder: re-rendering the table on every keystroke normally steals focus.
   This restores focus + cursor position right after the re-render so typing feels uninterrupted. */
function bindSearchInput(id, onInput){
  const el = document.getElementById(id);
  if(!el) return;
  el.addEventListener('input', e=>{
    const pos = e.target.selectionStart;
    const val = e.target.value;
    onInput(val);
    renderContent();
    const el2 = document.getElementById(id);
    if(el2){ el2.value = val; el2.focus(); try{ el2.setSelectionRange(pos,pos); }catch(err){} }
  });
}

