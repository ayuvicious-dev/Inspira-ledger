          postJurnal({ tanggal:todayStr(), keterangan:'Laba pelepasan aset: '+a.nama, debitId:a.akunAsetId, kreditId:pdAkun.id, nominal:-diff, sumber:'Aset', ref:'aset-lepas-laba-'+a.id });
        }
      }
      a.statusAktif = false; a.tanggalLepas = todayStr(); a.hargaLepas = hargaLepas;
      save(); renderContent(); toast('Aset dilepas dan jurnal penyesuaian diposting');
    });
    row.querySelector('.btnDelAset').addEventListener('click', ()=>{
