/* ---- Smart daily menu recommendation, based on current stock (recalculated live every render) ---- */
const MENU_KATEGORI_PRIORITAS = ['Nasi Karbohidrat','Lauk Protein','Sayur Serat','Buah Vitamin','Air Putih Mineral','Snack'];
const MEAL_SLOTS = [
  {nama:'Pagi', kategori:['Nasi Karbohidrat','Lauk Protein','Air Putih Mineral']},
  {nama:'Siang', kategori:['Nasi Karbohidrat','Lauk Protein','Sayur Serat','Air Putih Mineral']},
  {nama:'Sore', kategori:['Snack','Buah Vitamin']},
  {nama:'Malam', kategori:['Nasi Karbohidrat','Lauk Protein','Sayur Serat','Air Putih Mineral']},
];
function matchResepKategoriBudget(r){
  const j = (r.jenisResep||'').toLowerCase();
  if(j.includes('protein')||j.includes('lauk')) return 'Lauk Protein';
  if(j.includes('karbohidrat')||j.includes('nasi')) return 'Nasi Karbohidrat';
  if(j.includes('sayur')) return 'Sayur Serat';
  if(j.includes('buah')) return 'Buah Vitamin';
  if(j.includes('air')||j.includes('minuman')||j.includes('minum')) return 'Air Putih Mineral';
  if(j.includes('snack')||j.includes('camilan')) return 'Snack';
  return null;
}
function resepStockScore(r){
  return (r.bahan||[]).filter(b=>b.tipe==='produk').reduce((s,b)=>{
    const p = DB.produk.find(x=>x.id===b.refId);
    return s + (p ? (p.stok||0) : 0);
  }, 0);
}
/* Deterministic-but-varied pick: ranks candidates by remaining stock (use up abundant stock first),
   then rotates among the top few based on the date so consecutive days don't repeat the same thing. */
function getRekomendasiHarian(dateStr){
  const dayNum = Number(dateStr.slice(8,10)) || 1;
  return MEAL_SLOTS.map((slot, slotIdx)=>{
    const menus = slot.kategori.map((kat, katIdx)=>{
      const kandidat = DB.resep.filter(r=> matchResepKategoriBudget(r)===kat);
      if(kandidat.length===0) return { kategori:kat, resep:null };
      const scored = kandidat.map(r=>({r, score:resepStockScore(r)})).sort((a,b)=> b.score-a.score);
      const top = scored.slice(0, Math.min(3, scored.length));
      const pick = top[(dayNum + slotIdx + katIdx) % top.length].r;
      return { kategori:kat, resep:pick };
    }).filter(m=>m.resep);
    return { slot: slot.nama, menus };
  });
}

