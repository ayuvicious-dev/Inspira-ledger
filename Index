/* Reverses a purchase's effect on an item's running-average cost, stock, and monthly budget realization.
   Used by both edit (reverse-old + apply-new) and delete (reverse-only). Handles both bahan (DB.produk) and barang (DB.barang). */
function reversePembelianEffect(p){
  if(p.jenis==='barang'){
    const b = DB.barang.find(x=>x.id===p.barangId);
    if(b){
      b.runQty = Math.max(0, (b.runQty||0) - p.qty);
      b.runTotal = Math.max(0, (b.runTotal||0) - p.total);
      b.hargaBeliPerSatuan = b.runQty>0 ? (b.runTotal/b.runQty) : 0;
      b.stok = (b.stok||0) - p.qty;
    }
    return;
  }
  const prod = DB.produk.find(x=>x.id===p.produkId);
  if(prod){
    prod.runQty = Math.max(0, (prod.runQty||0) - p.qty);
    prod.runTotal = Math.max(0, (prod.runTotal||0) - p.total);
    prod.hargaBeliPerSatuan = prod.runQty>0 ? (prod.runTotal/prod.runQty) : 0;
    prod.stok = (prod.stok||0) - p.qty;
  }
  const bulan = p.tanggal.slice(0,7);
  const bud = DB.budgeting.find(x=> x.produkId===p.produkId && x.tanggal.slice(0,7)===bulan);
  if(bud) bud.realisasi = Math.max(0, (bud.realisasi||0) - p.total);
}
function applyPembelianEffect(p){
  if(p.jenis==='barang'){
    const b = DB.barang.find(x=>x.id===p.barangId);
    if(b){
      b.runQty = (b.runQty||0) + p.qty;
      b.runTotal = (b.runTotal||0) + p.total;
      b.hargaBeliPerSatuan = b.runQty>0 ? (b.runTotal/b.runQty) : 0;
      b.stok = (b.stok||0) + p.qty;
    }
    return;
  }
  const prod = DB.produk.find(x=>x.id===p.produkId);
  if(prod){
    prod.runQty = (prod.runQty||0) + p.qty;
    prod.runTotal = (prod.runTotal||0) + p.total;
    prod.hargaBeliPerSatuan = prod.runQty>0 ? (prod.runTotal/prod.runQty) : 0;
    prod.stok = (prod.stok||0) + p.qty;
  }
  const bulan = p.tanggal.slice(0,7);
  const bud = DB.budgeting.find(x=> x.produkId===p.produkId && x.tanggal.slice(0,7)===bulan);
  if(bud) bud.realisasi = (bud.realisasi||0) + p.total;
}

