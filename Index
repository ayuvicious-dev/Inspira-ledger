function renderBukuBesarResult(){
  const wrap = document.getElementById('bbResult'); if(!wrap) return;
  if(!bukuBesarAkun){ wrap.innerHTML = '<div class="empty">Pilih akun untuk melihat buku besarnya</div>'; return; }
  const akun = akunById(bukuBesarAkun);
  const isDebitNormal = normalIsDebit(akun.kategori);
  let running = 0;
  const rows = DB.jurnal.filter(j=> (j.debitId===akun.id||j.kreditId===akun.id) && matchSearch(j.keterangan, bukuBesarSearch));
  let html = `<div class="card">
    <div class="section-title"><h3>${akun.nama} <span class="mini">(${KAT[akun.kategori]} — ${akun.kepemilikan})</span></h3><span class="hint">Saldo saat ini: <b>${fmtRp(saldoAkun(akun.id))}</b></span></div>
