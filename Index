    const waktuMenit = Number(document.getElementById('newStepWaktu').value)||0;
    r.steps.push({ id:uid(), kategori, keterangan, gramasi: gramasi?Number(gramasi):null, waktuMenit });
    save(); renderContent();
  });
  c.querySelectorAll('.btnDelStep').forEach(btn=> btn.addEventListener('click', ()=>{ r.steps.splice(Number(btn.dataset.i),1); save(); renderContent(); }));
