  document.getElementById('btnPostJurnal').addEventListener('click', ()=>{
    syncJurnalRowsFromDom();
    const debitLines = jurnalRows.filter(r=>r.tipe==='debit' && r.akunId && Number(r.nominal)>0).map(r=>({akunId:r.akunId, nominal:Number(r.nominal)}));
    const kreditLines = jurnalRows.filter(r=>r.tipe==='kredit' && r.akunId && Number(r.nominal)>0).map(r=>({akunId:r.akunId, nominal:Number(r.nominal)}));
    if(debitLines.length===0 || kreditLines.length===0) return toast('Isi minimal 1 baris Debit & 1 baris Kredit (akun + nominal)');
    const overlap = debitLines.some(d=> kreditLines.some(k=> k.akunId===d.akunId));
    if(overlap) return toast('Akun yang sama tidak boleh dipakai di Debit dan Kredit sekaligus');
    const totalDebit = debitLines.reduce((s,l)=>s+l.nominal,0);
    const totalKredit = kreditLines.reduce((s,l)=>s+l.nominal,0);
    if(Math.abs(totalDebit-totalKredit)>0.5) return toast('Total Debit & Kredit belum sama, selisih Rp'+fmtNum(Math.abs(totalDebit-totalKredit),0));
    const tags = parseTagInput(jTagInput.value); tags.forEach(ensureTag);
    const groupRef = 'jurnal-manual-'+uid();
    const pairs = splitCompoundEntry(debitLines, kreditLines);
    pairs.forEach(p=> postJurnal({tanggal:jTgl.value, keterangan:jKet.value, debitId:p.debitId, kreditId:p.kreditId, nominal:p.nominal, sumber:'Jurnal Umum', ref:groupRef, tags}));
    save();
    jKet.value=''; jTagInput.value='';
    jurnalRows = [{rid:uid(),tipe:'debit',akunId:'',nominal:''},{rid:uid(),tipe:'kredit',akunId:'',nominal:''}];
    renderContent(); toast('Jurnal diposting ('+pairs.length+' baris)');
  });
};

function renderJurnalTable(){
  const wrap = document.getElementById('jurnalTableWrap'); if(!wrap) return;
  const titleEl = document.getElementById('jurnalCountTitle'); if(titleEl) titleEl.textContent = 'Riwayat Jurnal ('+DB.jurnal.length+')';
