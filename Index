  <div class="section-title"><h3>Daftar User (${DB.users.length})</h3></div>
  <div class="tablewrap"><table class="sheet"><thead><tr><th>Email</th><th>Role</th><th></th></tr></thead><tbody>
  ${DB.users.map(u=>`<tr><td>${u.email}</td><td><span class="tag ${u.role==='Admin'?'a':'b'}">${u.role}</span></td><td>${u.id!==DB.currentUserId?`<button class="btn small danger btnDelUser" data-id="${u.id}">Hapus</button>`:'<span class="mini">Sedang login</span>'}</td></tr>`).join('')}
  </tbody></table></div>
  <div class="mini" style="margin-top:8px">Staff tidak bisa mengakses Aset Tetap & Perubahan Modal. Semua role bisa input transaksi harian.</div>
  </div>
  <div class="card" style="margin-top:14px">
    <div class="section-title"><h3>Export Data (CSV)</h3></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" id="expProduk">Export Produk (CSV)</button>
      <button class="btn" id="expJurnal">Export Jurnal (CSV)</button>
      <button class="btn" id="expPembelian">Export Pembelian (CSV)</button>
    </div>
  </div>`;
  c.innerHTML = html;
  document.getElementById('btnAddUser').addEventListener('click', ()=>{
    const email = uEmail.value.trim().toLowerCase(), pass = uPass.value, role = uRole.value;
    if(!email||!pass) return toast('Lengkapi email & password');
    if(DB.users.some(u=>u.email===email)) return toast('Email sudah terdaftar');
    DB.users.push({ id:uid(), email, password:pass, role });
    save(); renderContent(); toast('User ditambahkan');
  });
  c.querySelectorAll('.btnDelUser').forEach(btn=> btn.addEventListener('click', ()=>{
    if(!confirm('Hapus user ini?')) return;
    DB.users = DB.users.filter(u=>u.id!==btn.dataset.id); save(); renderContent();
  }));
  function downloadCsv(filename, rows){
    const csv = rows.map(r=> r.map(v=> `"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
    const url = URL.createObjectURL(blob); const a=document.createElement('a');
    a.href=url; a.download=filename; a.click(); URL.revokeObjectURL(url);
  }
  document.getElementById('expProduk').addEventListener('click', ()=>{
    const rows = [['Kode','Nama','Jenis Bahan','Kategori','Satuan','Kepemilikan','Harga per satuan','Stok']];
    DB.produk.forEach(p=> rows.push([p.kode,p.nama,p.jenisBahan,p.kategori,p.satuan,p.kepemilikan,p.hargaBeliPerSatuan,p.stok]));
    downloadCsv('produk.csv', rows);
  });
  document.getElementById('expJurnal').addEventListener('click', ()=>{
    const rows = [['Tanggal','Keterangan','Akun Debit','Akun Kredit','Nominal','Sumber','Tag']];
    DB.jurnal.forEach(j=> rows.push([j.tanggal,j.keterangan,akunById(j.debitId)?.nama,akunById(j.kreditId)?.nama,j.nominal,j.sumber,(j.tags||[]).join('|')]));
    downloadCsv('jurnal.csv', rows);
  });
  document.getElementById('expPembelian').addEventListener('click', ()=>{
    const rows = [['Tanggal','Dibayar Melalui','Jenis','Barang','Qty','Total','Keterangan']];
    DB.pembelian.forEach(p=> rows.push([p.tanggal, akunById(p.bayarId)?.nama, p.jenis==='barang'?'Barang':'Bahan', pembelianItemNama(p), p.qty, p.total, p.keterangan]));
    downloadCsv('pembelian.csv', rows);
  });
};

/* ================= EXPORT / IMPORT / INIT ================= */
function initApp(){
  load();
  if(!DB.currentUserId){ renderLoginScreen(); return; }
  finishInit();
}
function openSidebar(){ document.getElementById('sidebar').classList.add('open'); document.getElementById('sidebarBackdrop').classList.add('open'); }
function closeSidebar(){ document.getElementById('sidebar').classList.remove('open'); document.getElementById('sidebarBackdrop').classList.remove('open'); }
function toggleSidebar(){ document.getElementById('sidebar').classList.contains('open') ? closeSidebar() : openSidebar(); }

function finishInit(){
  renderNav();
  switchTab('dashboard');
  document.getElementById('hamburgerBtn').addEventListener('click', toggleSidebar);
  document.getElementById('sidebarBackdrop').addEventListener('click', closeSidebar);
  const u = getCurrentUser();
  const actions = document.getElementById('topbar-actions');
  if(u && actions && !document.getElementById('userBadge')){
    const span = document.createElement('span');
    span.id = 'userBadge'; span.className='mini';
    span.style.marginRight='8px';
    span.textContent = u.email+' ('+u.role+')';
    actions.prepend(span);
    const logoutBtn = document.createElement('button');
    logoutBtn.className='btn small'; logoutBtn.textContent='Keluar';
    logoutBtn.addEventListener('click', logout);
    actions.appendChild(logoutBtn);
  }

  document.getElementById('btnExport').addEventListener('click', ()=>{
    const blob = new Blob([JSON.stringify(DB,null,2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'inspira-ledger-backup-'+todayStr()+'.json';
    a.click(); URL.revokeObjectURL(url);
    toast('Backup diunduh');
  });
  document.getElementById('btnImport').addEventListener('click', ()=> document.getElementById('fileImport').click());
  document.getElementById('fileImport').addEventListener('change', e=>{
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = ev=>{
      try{
        const data = JSON.parse(ev.target.result);
        if(!data.coa) throw new Error('format tidak dikenali');
        if(!confirm('Restore akan menimpa semua data saat ini. Lanjutkan?')) return;
        DB = data; save(); switchTab('dashboard'); toast('Data berhasil di-restore');
      }catch(err){ toast('File tidak valid: '+err.message); }
    };
    reader.readAsText(file);
  });
}

document.addEventListener('DOMContentLoaded', initApp);

</script>
<script>
  // Register service worker for offline support (PWA)
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('service-worker.js').catch(err => console.warn('SW registration failed:', err));
    });
  }
  // Optional: show a lightweight "Install app" button when the browser allows it
  let deferredInstallPrompt = null;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredInstallPrompt = e;
    const btn = document.createElement('button');
    btn.textContent = '⬇ Install Aplikasi';
    btn.className = 'btn primary';
    btn.style.marginRight = '8px';
    btn.addEventListener('click', async () => {
      if (!deferredInstallPrompt) return;
      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = null;
      btn.remove();
    });
    const actions = document.getElementById('topbar-actions');
    if (actions) actions.prepend(btn);
  });
</script>
