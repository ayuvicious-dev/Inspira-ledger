  rows.forEach(j=>{
    const isDebit = j.debitId===akun.id;
    const delta = isDebit? (isDebitNormal?j.nominal:-j.nominal) : (isDebitNormal?-j.nominal:j.nominal);
    running += delta;
    html += `<tr><td>${j.tanggal}</td><td>${j.keterangan||'-'}</td><td class="num">${isDebit?fmtRp(j.nominal):''}</td><td class="num">${!isDebit?fmtRp(j.nominal):''}</td><td class="num">${fmtRp(running)}</td><td>${tagChipsHtml(j.tags)}</td><td><button class="btn small editJ" data-jid="${j.id}">Edit</button> <button class="btn small danger delJ" data-jid="${j.id}">Hapus</button></td></tr>`;
  });
  if(rows.length===0) html += `<tr><td colspan="7" class="empty">Belum ada transaksi</td></tr>`;
  html += `</tbody></table></div></div>`;
  wrap.innerHTML = html;
  bindJurnalRowActions(wrap);
}

