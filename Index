    const idx = prompt('Pilih nomor sub-resep:\n'+list); if(!idx) return;
    const sub = others[Number(idx)-1]; if(!sub) return toast('Nomor tidak valid');
    const qty = Number(prompt('Qty porsi sub-resep dipakai:','1'))||0;
    r.bahan.push({ id:uid(), tipe:'resep', refId: sub.id, qty }); save(); renderContent();
