/* ---------------- RESEP: cost & time roll-up ---------------- */
function getResepPorsi(r){ return (r.jumlahPorsi && r.jumlahPorsi>0) ? r.jumlahPorsi : 1; }

function getTotalWaktuResep(resepId, visited){
  visited = visited || new Set();
  if(visited.has(resepId)) return 0;
  visited.add(resepId);
  const r = DB.resep.find(x=>x.id===resepId);
  if(!r) return 0;
  let total = (r.steps||[]).reduce((s,st)=> s+(Number(st.waktuMenit)||0), 0);
  (r.bahan||[]).forEach(b=>{ if(b.tipe==='resep') total += getTotalWaktuResep(b.refId, visited); });
  return total;
}

function computeResepTotalHarga(resepId, visited){
  visited = visited || new Set();
  if(visited.has(resepId)) return 0;
  visited.add(resepId);
  const r = DB.resep.find(x=>x.id===resepId);
  if(!r) return 0;
  let total = 0;
  (r.bahan||[]).forEach(b=>{
    if(b.tipe==='produk'){
      const prod = DB.produk.find(x=>x.id===b.refId); if(!prod) return;
      total += (Number(b.qty)||0) * (prod.hargaBeliPerSatuan||0);
    } else if(b.tipe==='resep'){
      const sub = DB.resep.find(x=>x.id===b.refId); if(!sub) return;
      const subTotal = computeResepTotalHarga(b.refId, visited);
      total += (Number(b.qty)||0) * (subTotal / getResepPorsi(sub));
    }
  });
  return total;
}
