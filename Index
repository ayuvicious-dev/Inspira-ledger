<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Inspira Ledger — Akuntansi Terintegrasi</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#2C2620">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Inspira Ledger">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#F7F1E8;
  --paper:#FFFDF9;
  --ink:#2C2620;
  --ink-soft:#6B6055;
  --terracotta:#C1603D;
  --terracotta-dark:#9E4B2F;
  --sage:#7C8B6F;
  --sage-soft:#E4E9DE;
  --line:#E4DACB;
  --debit:#2F6B4F;
  --kredit:#B0432C;
  --warn:#C88A2A;
  --shadow: 0 1px 2px rgba(44,38,32,.06), 0 4px 14px rgba(44,38,32,.05);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--cream);color:var(--ink)}
body{font-size:14px;line-height:1.45}
h1,h2,h3,h4{font-family:'Poppins',system-ui,sans-serif;margin:0;letter-spacing:-.01em}
button{font-family:inherit;cursor:pointer}
input,select{font-family:inherit;font-size:13.5px}
table{border-collapse:collapse;width:100%}
::-webkit-scrollbar{height:8px;width:8px}
::-webkit-scrollbar-thumb{background:#D8CBB4;border-radius:8px}

/* ---- shell ---- */
#shell{display:flex;min-height:100vh}
#sidebar{
  width:236px;flex:none;background:linear-gradient(180deg,#2C2620,#241F1A);
  color:#EFE7DA;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto;
}
#brand{padding:22px 20px 14px;border-bottom:1px solid rgba(255,255,255,.08)}
#brand .mark{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--terracotta),var(--terracotta-dark));display:flex;align-items:center;justify-content:center;font-family:'Poppins';font-weight:700;color:#fff;font-size:16px;margin-bottom:10px}
#brand h1{font-size:16.5px;color:#fff}
#brand p{margin:2px 0 0;font-size:11px;color:#B7AB98;letter-spacing:.04em;text-transform:uppercase}
nav{padding:10px 10px 20px;flex:1}
.navgroup{margin-top:14px}
.navgroup .glabel{font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:#8B7F6E;padding:6px 10px 4px;font-weight:600}
.navbtn{display:flex;align-items:center;gap:9px;width:100%;background:none;border:none;color:#D8CDBC;text-align:left;padding:9px 10px;border-radius:8px;font-size:13.3px;margin-bottom:1px;transition:.12s}
.navbtn:hover{background:rgba(255,255,255,.06);color:#fff}
.navbtn.active{background:var(--terracotta);color:#fff;font-weight:600}
.navbtn .dot{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.55;flex:none}

#main{flex:1;min-width:0;display:flex;flex-direction:column}
#topbar{
  position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:1px solid var(--line);
  padding:14px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px;
}
#topbar h2{font-size:19px}
#topbar .sub{color:var(--ink-soft);font-size:12.5px;margin-top:2px}
#topbar-actions{display:flex;gap:8px;align-items:center}
#content{padding:24px 28px 60px;max-width:1360px;width:100%}

/* ---- generic components ---- */
.card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow)}
.grid{display:grid;gap:14px}
.grid.cols-4{grid-template-columns:repeat(4,1fr)}
.grid.cols-3{grid-template-columns:repeat(3,1fr)}
.grid.cols-2{grid-template-columns:repeat(2,1fr)}
@media(max-width:1000px){.grid.cols-4{grid-template-columns:repeat(2,1fr)}.grid.cols-3{grid-template-columns:repeat(2,1fr)}}

.kpi .label{font-size:11.5px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.05em;font-weight:600}
.kpi .value{font-family:'Poppins';font-size:22px;margin-top:6px;font-weight:600}
.kpi .value.pos{color:var(--debit)}
.kpi .value.neg{color:var(--kredit)}

.btn{border:1px solid var(--line);background:var(--paper);color:var(--ink);padding:8px 14px;border-radius:9px;font-size:13px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
.btn:hover{border-color:var(--terracotta);color:var(--terracotta-dark)}
.btn.primary{background:var(--terracotta);color:#fff;border-color:var(--terracotta)}
.btn.primary:hover{background:var(--terracotta-dark);color:#fff}
.btn.ghost{border-color:transparent;background:transparent}
.btn.danger{color:var(--kredit)}
.btn.small{padding:5px 10px;font-size:12px;border-radius:7px}

.section-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;gap:10px;flex-wrap:wrap}
.section-title h3{font-size:15.5px}
.section-title .hint{font-size:12px;color:var(--ink-soft)}

.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:12px;background:var(--paper)}
table.sheet{min-width:100%}
table.sheet thead th{
  position:sticky;top:0;background:#F1E9DC;color:var(--ink);font-size:11.3px;text-transform:uppercase;letter-spacing:.03em;
  padding:9px 10px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap;font-weight:700;
}
table.sheet tbody td{padding:7px 10px;border-bottom:1px solid #EFE7D9;font-size:13px;white-space:nowrap}
table.sheet td.wrap-cell{white-space:normal;min-width:160px;max-width:280px}
table.sheet td.akun-nama-cell{white-space:normal;min-width:230px;max-width:440px}
table.sheet td.akun-nama-cell input{min-width:220px}
table.sheet td select{min-width:118px}
table.sheet td input{min-width:90px}
table.sheet td.wrap-cell input{min-width:160px}
table.sheet tbody tr:hover{background:#FBF6EC}
table.sheet tbody tr:last-child td{border-bottom:none}
table.sheet td input,table.sheet td select{border:1px solid transparent;background:transparent;width:100%;padding:4px 5px;border-radius:6px}
table.sheet td input:hover,table.sheet td select:hover{border-color:var(--line)}
table.sheet td input:focus,table.sheet td select:focus{outline:none;border-color:var(--terracotta);background:#fff}
.num{font-variant-numeric:tabular-nums;text-align:right}
.center{text-align:center}

.tag{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600}
.tag.pribadi{background:#E9E2F3;color:#5B4A8A}
.tag.a{background:#DDEBE0;color:#2F6B4F}
.tag.b{background:#FCE8D9;color:#B0602A}
.tag.c{background:#DCEAF3;color:#2D6B8A}
.tag.debit{background:#E4EFE8;color:var(--debit)}
.tag.kredit{background:#F5E1DA;color:var(--kredit)}

.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:14px}
.field label{display:block;font-size:11.3px;font-weight:600;color:var(--ink-soft);margin-bottom:4px;text-transform:uppercase;letter-spacing:.03em}
.field input,.field select,.field textarea{
  width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:9px;background:#fff;font-size:13.5px;color:var(--ink);
}
.field textarea{resize:vertical;min-height:38px}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--terracotta);box-shadow:0 0 0 3px rgba(193,96,61,.12)}

.tabs2{display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:0}
.tabs2 button{background:none;border:none;padding:9px 14px;font-size:13.3px;font-weight:600;color:var(--ink-soft);border-bottom:2px solid transparent;margin-bottom:-1px}
.tabs2 button.active{color:var(--terracotta-dark);border-color:var(--terracotta)}

.empty{padding:34px 16px;text-align:center;color:var(--ink-soft)}
.empty .big{font-size:26px;margin-bottom:6px}

.recap{background:#F1EADC;border-radius:10px;padding:10px 14px;margin-top:10px;font-size:12.8px;display:flex;gap:22px;flex-wrap:wrap}
.recap b{font-family:'Poppins';font-size:14.5px}

.badge-balance{padding:3px 10px;border-radius:99px;font-size:11.5px;font-weight:700}
.badge-balance.ok{background:#DDEBE0;color:var(--debit)}
.badge-balance.bad{background:#F5DAD2;color:var(--kredit)}

.rowline{display:grid;grid-template-columns:1.6fr 1fr 1fr auto;gap:8px;align-items:center;margin-bottom:6px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:820px){.two-col{grid-template-columns:1fr}}

.loc-block{margin-bottom:16px}
.loc-block h4{font-size:12.8px;color:var(--terracotta-dark);margin-bottom:8px;text-transform:uppercase;letter-spacing:.04em}
.chip{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:9px;padding:6px 10px;font-size:12.3px;margin:0 6px 6px 0}
.chip.low{border-color:var(--kredit);background:#FBEDE8}

.toast{position:fixed;bottom:20px;right:20px;background:#2C2620;color:#fff;padding:11px 16px;border-radius:10px;font-size:13px;box-shadow:var(--shadow);z-index:50;opacity:0;transform:translateY(8px);transition:.2s}
.toast.show{opacity:1;transform:translateY(0)}

.hidden{display:none !important}
.mini{font-size:11.5px;color:var(--ink-soft)}
a.resepLink:hover,a.subResepLink:hover,a.crumbLink:hover{text-decoration:underline !important}
a.crumbLink{color:var(--ink-soft);text-decoration:none}
a.crumbLink:last-child{color:var(--terracotta-dark);font-weight:600}

/* ---- Searchable account picker ---- */
.akunPickerInput{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:9px;background:#fff;font-size:13.5px;color:var(--ink)}
.akunPickerInput:focus{outline:none;border-color:var(--terracotta);box-shadow:0 0 0 3px rgba(193,96,61,.12)}
.akunPickerList{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;max-height:240px;overflow-y:auto;
  background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);z-index:40}
.akunPickerItem{padding:8px 12px;font-size:13px;cursor:pointer;border-bottom:1px solid #F1EADC}
.akunPickerItem:last-child{border-bottom:none}
.akunPickerItem:hover{background:#FBF6EC}

/* ---- Resep grid: vertical cards (image on top, details stacked below) ---- */
.resep-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:16px}
.resep-card{border:1px solid var(--line);border-radius:13px;overflow:hidden;background:var(--paper);box-shadow:var(--shadow);display:flex;flex-direction:column}
.resep-card-img{width:100%;height:140px;background:#F1EADC;display:flex;align-items:center;justify-content:center;font-size:40px;flex:none}
.resep-card-img img{width:100%;height:100%;object-fit:cover}
.resep-card-body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:6px}
.resep-card-body a.resepLink{color:var(--terracotta-dark);font-weight:700;font-size:14.5px;text-decoration:none;margin-bottom:2px}
.resep-card-row{display:flex;justify-content:space-between;align-items:center;font-size:12.8px;padding:2px 0;border-bottom:1px dashed #EEE3D2}
.resep-card-row:last-of-type{border-bottom:none}

/* ---- Mobile layout: off-canvas sidebar, compact tables (BCA Bisnis style) ---- */
#hamburgerBtn{display:none}
#sidebarBackdrop{display:none}
@media(max-width:820px){
  #shell{display:block}
  #sidebar{
    position:fixed;top:0;left:0;height:100vh;width:78vw;max-width:300px;z-index:60;
    transform:translateX(-100%);transition:transform .22s ease;box-shadow:8px 0 24px rgba(0,0,0,.25);
  }
  #sidebar.open{transform:translateX(0)}
  #sidebarBackdrop{
    display:none;position:fixed;inset:0;background:rgba(20,16,12,.45);z-index:55;
  }
  #sidebarBackdrop.open{display:block}
  #main{width:100%}
  #hamburgerBtn{
    display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;
    border-radius:9px;border:1px solid var(--line);background:var(--paper);font-size:18px;margin-right:8px;flex:none;
  }
  #topbar{padding:10px 12px;flex-wrap:nowrap;gap:8px}
  #topbar h2{font-size:16px}
  #topbar .sub{display:none}
  #topbar-actions{gap:5px}
  #topbar-actions .btn{padding:6px 9px;font-size:11.5px}
  #userBadge{display:none}
  #content{padding:12px 10px 40px}
  .card{padding:12px 12px;border-radius:11px}
  .grid.cols-4,.grid.cols-3,.grid.cols-2{grid-template-columns:1fr 1fr;gap:8px}
  .kpi .value{font-size:16px}
  .kpi .label{font-size:10px}
  .formgrid{grid-template-columns:1fr 1fr;gap:8px}
  .two-col{grid-template-columns:1fr}
  table.sheet thead th{font-size:10px;padding:7px 6px}
  table.sheet tbody td{font-size:12px;padding:6px 6px}
  table.sheet td select,table.sheet td input{font-size:12px;min-width:76px}
  table.sheet td.wrap-cell{min-width:120px;max-width:180px}
  .tablewrap{-webkit-overflow-scrolling:touch;border-radius:9px}
  .section-title{gap:8px}
  .section-title h3{font-size:14px}
  .btn{padding:7px 11px;font-size:12.5px}
  #brand{padding:16px 16px 12px}
  .resep-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
  .resep-card-img{height:100px;font-size:28px}
  .resep-card-body{padding:8px 10px 10px}
}
</style>
</head>
<body>
<div id="shell">
  <div id="sidebarBackdrop"></div>
  <aside id="sidebar">
    <div id="brand">
      <div class="mark">IE</div>
      <h1>Inspira Ledger</h1>
      <p>Akuntansi Terpadu</p>
    </div>
    <nav id="nav"></nav>
  </aside>
  <main id="main">
    <div id="topbar">
      <div style="display:flex;align-items:center">
        <button id="hamburgerBtn">☰</button>
        <div>
          <h2 id="pagetitle">Dashboard</h2>
          <div class="sub" id="pagesub">Ringkasan posisi keuangan</div>
        </div>
      </div>
      <div id="topbar-actions">
        <button class="btn" id="btnExport">⬇ Backup JSON</button>
        <button class="btn" id="btnImport">⬆ Restore</button>
        <input type="file" id="fileImport" accept="application/json" class="hidden">
      </div>
    </div>
    <div id="content"></div>
  </main>
</div>
<div class="toast" id="toast"></div>
<script>
/* ============================================================
   INSPIRA LEDGER — Aplikasi Akuntansi Terpadu (offline, localStorage)
   ============================================================ */
const STORAGE_KEY = 'inspira_ledger_db_v1';
const KEPEMILIKAN = ['Pribadi','Bisnis A','Bisnis B','Bisnis C'];
const KAT = {
  AL:'Aset Lancar', PS:'Aset Persediaan', PSB:'Aset Persediaan Barang', ALL:'Aset Lancar Lainnya', AT:'Aset Tetap',
  KAT:'Kontra Aset Tetap', ALN:'Aset Lainnya', KW:'Kewajiban', MD:'Modal',
  PD:'Pendapatan', BPP:'Beban Pokok Penjualan', BO:'Beban Operasional', BL:'Beban Lain'
};
/* Fixed display order for account categories, used everywhere a list of accounts is shown
   (COA table, pickers, etc.) so related accounts always group together top-to-bottom. */
const KATEGORI_ORDER = ['AL','PS','PSB','ALL','ALN','AT','KAT','KW','MD','PD','BPP','BO','BL'];
function sortAkunList(list){
  return [...list].sort((a,b)=>{
    const oa = KATEGORI_ORDER.indexOf(a.kategori), ob = KATEGORI_ORDER.indexOf(b.kategori);
    if(oa!==ob) return oa-ob;
    if(a.kepemilikan!==b.kepemilikan) return KEPEMILIKAN.indexOf(a.kepemilikan)-KEPEMILIKAN.indexOf(b.kepemilikan);
    return a.nama.localeCompare(b.nama);
  });
}
const DEBIT_NORMAL = new Set(['AL','PS','PSB','ALL','AT','ALN','BPP','BO','BL']);
const KREDIT_NORMAL = new Set(['KAT','KW','MD','PD']);
const LOKASI_FREEZER = Array.from({length:13},(_,i)=>'Freezer CH-'+String(i+1).padStart(2,'0'));
const LOKASI_KULKAS  = Array.from({length:6},(_,i)=>'Kulkas SH-'+String(i+1).padStart(2,'0'));
const LOKASI_ALL = [...LOKASI_FREEZER, ...LOKASI_KULKAS];
// default (bawaan) locations minus any the user has renamed/deleted via "Kelola Lokasi Custom"
function getEffectiveLokasiDefault(){ return LOKASI_ALL.filter(l=>!DB.lokasiHapus.includes(l)); }

function uid(){ return 'x'+Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4); }
function fmtRp(n){ n = Number(n)||0; return 'Rp' + n.toLocaleString('id-ID',{maximumFractionDigits:0}); }
function fmtNum(n,d=2){ n=Number(n)||0; return n.toLocaleString('id-ID',{maximumFractionDigits:d}); }
function todayStr(){ return new Date().toISOString().slice(0,10); }
function tagClassKep(k){ return k==='Pribadi'?'pribadi':k==='Bisnis A'?'a':k==='Bisnis B'?'b':'c'; }
function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(window.__tt); window.__tt=setTimeout(()=>t.classList.remove('show'),2200); }

/* ---------------- STATE ---------------- */
let DB = null;

function freshDB(){
  return {
    coa:[], jurnal:[], pembelian:[], penjualan:[], pemakaian:[], biaya:[], produk:[], resep:[],
    budgeting:[], budgetKalender:[], counters:{}, tags:[], lokasiCustom:[], lokasiHapus:[], lokasiBarangCustom:[], barang:[], aset:[],
    users:[], currentUserId:null,
    jenisBahanCustom:[], jenisResepCustom:['Sambal','Bumbu','Minuman','Makanan Utama','Camilan'],
    jenisAsetCustom:['Kendaraan','Mesin','Peralatan','Bangunan','Elektronik','Lainnya'],
    kategoriProdukCustom:['Bahan Mentah','Setengah Jadi','Menu Jadi'],
    satuanCustom:['pcs','gr','kg','ml','l','sdm','sdt','ikat','butir'],
    stepKategoriCustom:['Iris','Potong','Thawing','Blender','Tumis','Rebus','Goreng','Kukus','Oven','Air Fryer','Lainnya'],
    kepemilikanCustom:[]
  };
}

function load(){
  const raw = localStorage.getItem(STORAGE_KEY);
  if(raw){ try{ DB = JSON.parse(raw); }catch(e){ DB = freshDB(); } }
  else { DB = freshDB(); }
  if(!DB.coa || DB.coa.length===0){ seedCOA(); }
  // fill in any fields missing from older saved data
  const fresh = freshDB();
  Object.keys(fresh).forEach(k=>{ if(DB[k]===undefined) DB[k] = fresh[k]; });
  ensureDepresiasiAccounts();
  runOneTimeMigrations();
  save();
}

/* One-time migrations for people upgrading from an older saved version — each runs exactly once
   per browser (guarded by a flag on DB) so re-opening the app doesn't repeat them. */
function runOneTimeMigrations(){
  if(!DB._migrated_clearTrialKalender){
    DB.budgetKalender = []; // old manual trial entries — calendar is now auto-recommended, safe to clear
    DB._migrated_clearTrialKalender = true;
  }
  if(!DB._migrated_seedBudgetKategori){
    MENU_KATEGORI_PRIORITAS.forEach(kat=> ensureInList('jenisResepCustom', kat));
    DB._migrated_seedBudgetKategori = true;
  }
  if(!DB._migrated_asetAkumOtomatis){
    (DB.aset||[]).forEach(a=>{
      if(a.masaManfaatBulan>0 && !a.akunAkumulasiId && a.akunAsetId){
        const akunAset = akunById(a.akunAsetId);
        if(akunAset){
          let akumAkun = DB.coa.find(x=>x.kategori==='KAT' && x.kepemilikan===akunAset.kepemilikan && x.nama.toLowerCase().includes((a.jenis||'').toLowerCase()));
          if(!akumAkun) akumAkun = addAkun('KAT', 'Akumulasi Penyusutan - '+(a.jenis||a.nama), akunAset.kepemilikan, 'Kontra akun aset tetap (otomatis)');
          a.akunAkumulasiId = akumAkun.id;
        }
      }
    });
    DB._migrated_asetAkumOtomatis = true;
  }
}

function ensureDepresiasiAccounts(){
  getAllKepemilikan().forEach(kep=>{
    if(!DB.coa.find(a=>a.kategori==='BO' && a.kepemilikan===kep && a.nama==='Beban Penyusutan Aset')){
      addAkun('BO','Beban Penyusutan Aset', kep, 'Otomatis dari fitur Aset Tetap');
    }
    if(!DB.coa.find(a=>a.kategori==='PSB' && a.kepemilikan===kep)){
      addAkun('PSB', 'Persediaan Barang/Perlengkapan '+kep, kep, 'Nilai persediaan barang/perlengkapan menurut kartu stok barang');
    }
    if(!DB.coa.find(a=>a.kategori==='PD' && a.kepemilikan===kep && a.nama==='Pendapatan Penyesuaian Persediaan')){
      addAkun('PD','Pendapatan Penyesuaian Persediaan', kep, 'Otomatis dari penambahan stok manual di fitur Persediaan');
    }
    if(!DB.coa.find(a=>a.kategori==='BO' && a.kepemilikan===kep && a.nama==='Beban Penyesuaian Persediaan')){
      addAkun('BO','Beban Penyesuaian Persediaan', kep, 'Otomatis dari pengurangan stok manual di fitur Persediaan');
    }
  });
}
function save(){ localStorage.setItem(STORAGE_KEY, JSON.stringify(DB)); }

function nextKode(prefix){
  DB.counters[prefix] = (DB.counters[prefix]||0)+1;
  return prefix + '-' + String(DB.counters[prefix]).padStart(3,'0');
}

