/* ================= LABA RUGI (dengan filter tanggal & tag) ================= */
let lrFilter = { mode:'bulan_ini', dari:'', sampai:'', tag:'' };
function dateRangeForMode(mode){
  const now = new Date();
  const pad = n=>String(n).padStart(2,'0');
  const fmt = d=> d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
  if(mode==='hari_ini'){ return [fmt(now), fmt(now)]; }
  if(mode==='minggu_ini'){ const start=new Date(now); start.setDate(now.getDate()-now.getDay()); return [fmt(start), fmt(now)]; }
  if(mode==='bulan_ini'){ return [fmt(new Date(now.getFullYear(),now.getMonth(),1)), fmt(now)]; }
  if(mode==='bulan_lalu'){ const s=new Date(now.getFullYear(),now.getMonth()-1,1), e=new Date(now.getFullYear(),now.getMonth(),0); return [fmt(s), fmt(e)]; }
  if(mode==='tahun_ini'){ return [fmt(new Date(now.getFullYear(),0,1)), fmt(now)]; }
  if(mode==='tahun_lalu'){ return [fmt(new Date(now.getFullYear()-1,0,1)), fmt(new Date(now.getFullYear()-1,11,31))]; }
  return [lrFilter.dari, lrFilter.sampai];
}
function filteredJurnal(){
  let [dari, sampai] = lrFilter.mode==='custom' ? [lrFilter.dari, lrFilter.sampai] : dateRangeForMode(lrFilter.mode);
  return DB.jurnal.filter(j=>{
    if(dari && j.tanggal<dari) return false;
    if(sampai && j.tanggal>sampai) return false;
    if(lrFilter.tag && !(j.tags||[]).includes(lrFilter.tag)) return false;
    return true;
  });
}
function sumByKategoriKepemilikanFiltered(kategori, kepemilikan, jlist){
  const akunIds = new Set(DB.coa.filter(a=>a.kategori===kategori && (!kepemilikan||a.kepemilikan===kepemilikan)).map(a=>a.id));
  let debit=0, kredit=0;
  jlist.forEach(j=>{ if(akunIds.has(j.debitId)) debit+=j.nominal; if(akunIds.has(j.kreditId)) kredit+=j.nominal; });
  const isDebitNormal = DEBIT_NORMAL.has(kategori);
  return isDebitNormal ? debit-kredit : kredit-debit;
}
