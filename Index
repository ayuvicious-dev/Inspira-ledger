let penjualanSearch = '';
RENDERERS.penjualan = function(c){
  let html = `<div class="card">
    <div class="mini" style="margin-bottom:10px">Untuk penjualan sungguhan dengan nilai Rp — otomatis mencatat pendapatan sekaligus memindahkan bahan dari persediaan ke beban pokok.</div>
    <div class="formgrid">
      <div class="field"><label>Tanggal</label><input type="date" id="jlTgl" value="${todayStr()}"></div>
      <div class="field"><label>Menu (dari Resep)</label><select id="jlResep"><option value="">— pilih menu —</option>${DB.resep.map(r=>`<option value="${r.id}">${r.namaMenu}</option>`).join('')}</select></div>
      <div class="field"><label>Qty porsi terjual</label><input type="number" id="jlQty" placeholder="0"></div>
      <div class="field"><label>Total Harga Jual (Rp)</label><input type="number" id="jlHarga" placeholder="0"></div>
    </div>
    <div class="formgrid">
      <div class="field" style="grid-column:span 2"><label>Diterima ke akun</label>${akunPickerHtml('jlAkun', a=>['AL','ALL'].includes(a.kategori), 'Ketik nama akun...')}</div>
      ${tagInputHtml('jlTag')}
    </div>
    <button class="btn primary" id="btnPostPenjualan">Simpan Penjualan</button>
  </div>

  <div class="card" style="margin-top:14px">
  <div class="section-title"><h3 id="penjualanCountTitle">Riwayat Penjualan (${DB.penjualan.length})</h3>${searchBoxHtml('penjualanSearchInput','Cari menu')}</div>
  <div id="penjualanTableWrap"></div></div>`;
  c.innerHTML = html;
  bindAllAkunPickers(c);
  renderPenjualanTable();

  document.getElementById('penjualanSearchInput').addEventListener('input', e=>{ penjualanSearch=e.target.value; renderPenjualanTable(); });
  document.getElementById('btnPostPenjualan').addEventListener('click', ()=>{
    const resepId=jlResep.value, qty=Number(jlQty.value), harga=Number(jlHarga.value), akunId=jlAkun.value;
    if(!resepId||!akunId) return toast('Lengkapi menu & akun penerima');
    if(!qty||qty<=0) return toast('Isi qty');
    const resep = DB.resep.find(x=>x.id===resepId);
    if(!resep || (resep.bahan||[]).length===0) return toast('Resep ini belum punya bahan');

    const consumed = [];
    let nilaiBahan=0, kep='Pribadi';
    (function consumeBahan(list, mult){
      list.forEach(b=>{
        if(b.tipe==='produk'){
          const prod = DB.produk.find(x=>x.id===b.refId); if(!prod) return;
          const pakai = b.qty*qty*mult;
          consumed.push({prod, pakai});
        } else if(b.tipe==='resep'){
          const sub = DB.resep.find(x=>x.id===b.refId); if(!sub) return;
          consumeBahan(sub.bahan||[], b.qty*mult);
        }
      });
    })(resep.bahan, 1);

    consumed.forEach(({prod,pakai})=>{
      prod.stok = (prod.stok||0) - pakai;
      nilaiBahan += pakai*(prod.hargaBeliPerSatuan||0);
      kep = prod.kepemilikan;
    });

    const tags = parseTagInput(jlTag.value); tags.forEach(ensureTag);
    const pObj = { id:uid(), tanggal:jlTgl.value, resepId, qty, harga, nilaiBahan:Math.round(nilaiBahan), akunId, tags };
    DB.penjualan.push(pObj);

    const pdAkun = DB.coa.find(a=>a.kategori==='PD' && a.kepemilikan===kep) || DB.coa.find(a=>a.kategori==='PD');
    postJurnal({ tanggal:jlTgl.value, keterangan:'Penjualan '+resep.namaMenu+' x'+qty, debitId:akunId, kreditId:pdAkun.id, nominal:harga||1, sumber:'Penjualan', ref:'penjualan-pd-'+pObj.id, tags });
    if(nilaiBahan>0){
      const bppAkun = DB.coa.find(a=>a.kategori==='BPP' && a.kepemilikan===kep) || DB.coa.find(a=>a.kategori==='BPP');
      const psAkun = DB.coa.find(a=>a.kategori==='PS' && a.kepemilikan===kep) || DB.coa.find(a=>a.kategori==='PS');
      postJurnal({ tanggal:jlTgl.value, keterangan:'HPP '+resep.namaMenu+' x'+qty, debitId:bppAkun.id, kreditId:psAkun.id, nominal:Math.round(nilaiBahan), sumber:'Penjualan', ref:'penjualan-hpp-'+pObj.id, tags });
    }
    save();
    jlQty.value=''; jlHarga.value=''; jlTag.value=''; jlResep.value='';
    setAkunPickerValue('jlAkun', null);
    renderPenjualanTable(); toast('Penjualan tersimpan');
  });
};

