/* ================= ASET TETAP ================= */
let asetSearch = '';
function hitungDepresiasiBulanan(a){
  if(!a.masaManfaatBulan || a.masaManfaatBulan<=0) return 0;
  const dasar = (a.biayaAkuisisi||0) - (a.nilaiResidu||0);
  return Math.round(dasar / a.masaManfaatBulan);
}
function akumulasiPenyusutanAset(a){
  return DB.jurnal.filter(j=>j.ref==='aset-dep-'+a.id).reduce((s,j)=>s+j.nominal,0);
}
function sudahPostingPenyusutanBulanIni(a){
  const ym = todayStr().slice(0,7);
  return DB.jurnal.some(j=>j.ref==='aset-dep-'+a.id && j.tanggal && j.tanggal.slice(0,7)===ym);
}
