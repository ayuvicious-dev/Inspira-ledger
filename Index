    if(DB.lokasiCustom.includes(lama)){
      const idx = DB.lokasiCustom.indexOf(lama);
      DB.lokasiCustom[idx] = baru;
    } else {
      // built-in default location (Freezer/Kulkas) — hide old name, register new name as custom
      if(!DB.lokasiHapus.includes(lama)) DB.lokasiHapus.push(lama);
      if(!DB.lokasiCustom.includes(baru)) DB.lokasiCustom.push(baru);
    }
    DB.produk.forEach(p=>{ if(p.lokasi===lama) p.lokasi=baru; });
